{
	"name": "textmode.filters.js",
	"version": "1.2.3",
	"description": "Image filters plugin for textmode.js",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "^11.0.0",
			"onFail": "error"
		}
	},
	"main": "./dist/textmode.filters.umd.js",
	"module": "./dist/textmode.filters.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.filters.esm.js",
			"require": "./dist/textmode.filters.umd.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "textmode-build dev --port 5179 --host",
		"build:bundle": "textmode-build build",
		"build:types": "textmode-types build",
		"build": "npm run build:bundle && npm run build:types",
		"check": "textmode-project check",
		"docs:links:add": "textmode-docs links add",
		"docs:api:check": "textmode-docs api-check",
		"docs:check": "textmode-docs check",
		"docs:dev": "textmode-docs watch",
		"docs:build": "textmode-docs build",
		"preview": "textmode-build preview",
		"format": "textmode-lint format",
		"format:check": "textmode-lint format:check",
		"typecheck": "textmode-types check",
		"types:verify": "textmode-types verify",
		"lint:markdown": "textmode-lint lint:markdown",
		"lint:markdown:fix": "textmode-lint lint:markdown --fix",
		"lint": "textmode-lint lint src",
		"prepare": "install-git-hooks",
		"prepack": "textmode-project prepack",
		"release": "semantic-release",
		"test": "textmode-build test",
		"test:watch": "textmode-build test:watch"
	},
	"peerDependencies": {
		"textmode.js": ">=0.16.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@textmode/build": "^0.1.0",
		"@textmode/commitlint-config": "^0.1.1",
		"@textmode/docs": "^0.3.0",
		"@textmode/lint": "^0.1.0",
		"@textmode/release-config": "^0.1.2",
		"@textmode/tooling-scripts": "^0.5.0",
		"@textmode/tsconfig": "^0.2.0",
		"@types/node": "^24.0.0",
		"lint-staged": "^17.0.8",
		"semantic-release": "^25.0.5",
		"textmode.js": "^0.17.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"license": "MIT",
	"author": "humanbydefinition",
	"lint-staged": {
		"*": "textmode-lint format"
	},
	"prettier": "@textmode/lint/prettier",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"release": {
		"extends": "@textmode/release-config"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/humanbydefinition/textmode.filters.js"
	}
}
