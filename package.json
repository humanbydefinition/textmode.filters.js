{
	"name": "textmode.filters.js",
	"version": "1.2.2",
	"description": "Image filters plugin for textmode.js",
	"type": "module",
	"main": "./dist/textmode.filters.umd.js",
	"module": "./dist/textmode.filters.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.filters.esm.js",
			"require": "./dist/textmode.filters.umd.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --port 5179 --host",
		"build:bundle": "vite build",
		"build:types": "tsc",
		"build": "npm run build:bundle && npm run build:types",
		"check": "npm run check:format && npm run lint && npm run lint:md && npm run check:types && npm run check:docs && npm run test && npm run build",
		"docs:links:add": "textmode-docs links add",
		"check:api-docs": "textmode-docs api-check",
		"check:docs": "textmode-docs check",
		"dev:docs": "textmode-docs watch",
		"build:docs": "textmode-docs build",
		"preview": "vite preview",
		"format": "prettier --write . --ignore-path node_modules/@textmode/tooling-scripts/src/prettierignore",
		"check:format": "prettier --check . --ignore-path node_modules/@textmode/tooling-scripts/src/prettierignore",
		"check:types": "tsc --noEmit",
		"lint:md": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2 --fix",
		"lint": "eslint --config ./node_modules/@textmode/eslint-config/index.js src",
		"prepare": "install-git-hooks",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests",
		"test:ui": "vitest --ui --passWithNoTests",
		"test:coverage": "vitest --coverage --passWithNoTests"
	},
	"peerDependencies": {
		"textmode.js": ">=0.16.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@textmode/commitlint-config": "^0.1.1",
		"@textmode/docs": "file:../textmode-tooling/packages/docs",
		"@textmode/eslint-config": "^0.2.0",
		"@textmode/markdownlint-config": "^0.1.1",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/release-config": "^0.1.1",
		"@textmode/tooling-scripts": "^0.4.0",
		"@textmode/tsconfig": "^0.1.0",
		"@textmode/vite-config": "^0.1.0",
		"@textmode/vite-plugin-glsl": "0.1.0",
		"@types/node": "^26.1.1",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.6.0",
		"lint-staged": "^17.0.8",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.4",
		"semantic-release": "^25.0.5",
		"terser": "^5.46.1",
		"textmode.js": "^0.17.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vitest": "^4.1.10"
	},
	"license": "MIT",
	"author": "humanbydefinition",
	"lint-staged": {
		"*": "prettier --ignore-unknown --ignore-path node_modules/@textmode/tooling-scripts/src/prettierignore --write"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/humanbydefinition/textmode.filters.js"
	},
	"markdownlint-cli2": {
		"globs": [
			"**/*.md"
		],
		"ignores": [
			"api/**",
			"node_modules/**",
			"dist/**",
			"examples/**/*.md",
			"**/CHANGELOG.md"
		],
		"fix": false,
		"outputFormatters": [
			[
				"markdownlint-cli2-formatter-default"
			]
		],
		"config": {
			"extends": "@textmode/markdownlint-config"
		}
	}
}
