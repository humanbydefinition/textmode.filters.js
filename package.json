{
	"name": "textmode.filters.js",
	"version": "1.2.2",
	"description": "Image filters plugin for textmode.js",
	"type": "module",
	"main": "./dist/textmode.filters.umd.js",
	"module": "./dist/textmode.filters.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.filters.esm.js",
			"require": "./dist/textmode.filters.umd.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --port 5179 --host",
		"build:bundle": "vite build",
		"build:types": "tsc",
		"build": "npm run build:bundle && npm run build:types",
		"check": "npm run check:format && npm run check:deps && npm run lint && npm run lint:md && npm run check:types && npm run check:api-docs && npm run check:examples && npm run test && npm run build",
		"docs:links:add": "textmode-add-api-links",
		"check:api-docs": "textmode-check-api-docs",
		"check:examples": "textmode-check-examples",
		"dev:docs": "typedoc --watch",
		"build:docs": "typedoc",
		"preview": "vite preview",
		"format": "prettier --write .",
		"check:format": "prettier --check .",
		"check:types": "tsc --noEmit",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"lint": "eslint src",
		"prepare": "husky && install-husky",
		"check:deps": "check-deps",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests",
		"test:ui": "vitest --ui --passWithNoTests",
		"test:coverage": "vitest --coverage --passWithNoTests"
	},
	"peerDependencies": {
		"textmode.js": ">=0.16.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@mapwhit/glsl-minify": "^1.0.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@types/node": "^24.0.13",
		"eslint": "^9.39.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"markdownlint-cli2": "^0.22.1",
		"prettier": "^3.8.3",
		"semantic-release": "^25.0.3",
		"textmode.js": "^0.16.0",
		"typedoc": "^0.28.19",
		"typedoc-plugin-frontmatter": "^1.3.1",
		"typedoc-plugin-markdown": "^4.11.0",
		"typedoc-vitepress-theme": "^1.1.2",
		"typescript": "^5.9.2",
		"vite": "^6.3.4",
		"@textmode/commitlint-config": "^0.1.0",
		"@textmode/eslint-config": "^0.1.0",
		"@textmode/markdownlint-config": "^0.1.1",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/release-config": "^0.1.1",
		"@textmode/tooling-scripts": "^0.1.0",
		"@textmode/tsconfig": "^0.1.0",
		"vitest": "^3.1.2",
		"@vitest/ui": "^3.1.2"
	},
	"license": "MIT",
	"author": "humanbydefinition",
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/humanbydefinition/textmode.filters.js"
	}
}
